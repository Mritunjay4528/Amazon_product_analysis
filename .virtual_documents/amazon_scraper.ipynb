headers = {
    "User-Agent": "Mozilla/5.0"
}


url = "https://www.amazon.in/gp/bestsellers/"

response = requests.get(url, headers=headers)

print(response.status_code)


soup = BeautifulSoup(response.text, "lxml")

print(soup.title.text)


category_links = soup.find_all("a")

print(len(category_links))


categories = []

for link in category_links:
    
    href = link.get("href")
    text = link.text.strip()
    
    if href and "/gp/bestsellers/" in href:
        
        full_link = "https://www.amazon.in" + href
        
        categories.append((text, full_link))

print(categories[:20])


unique_categories = {}

for name, link in categories:
    
    if name not in unique_categories:
        unique_categories[name] = link

print(len(unique_categories))


