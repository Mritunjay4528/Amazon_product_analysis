import os

os.makedirs("raw_html", exist_ok=True)

print("Folder created")


wanted_categories = [
    "Books",
    "Computers & Accessories",
    "Electronics",
    "Jewellery",
    "Clothing & Accessories",
    "Shoes & Handbags",
    "Sports, Fitness & Outdoors",
    "Toys & Games",
    "Video Games",
    "Musical Instruments",
    "Bags, Wallets and Luggage"
]


categories = {}

all_links = soup.find_all("a")

for link in all_links:

    category_name = link.text.strip()

    if category_name in wanted_categories:

        href = link.get("href")

        full_url = "https://www.amazon.in" + href

        categories[category_name] = full_url

print(categories)


headers = {
    "User-Agent":
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36"
}


#delay between requests or we will get detected adn get blocked
import time


for category_name, url in categories.items():

    print(f"Scraping {category_name}")

    for page in range(1, 3):

        if page == 1:
            page_url = url

        else:
            page_url = url + f"?pg={page}"

        response = requests.get(page_url, headers=headers)

        file_name = f"raw_html/{category_name}_page{page}.html"

        with open(file_name, "w", encoding="utf-8") as file:

            file.write(response.text)

        print(f"Saved: {file_name}")

        time.sleep(2)



