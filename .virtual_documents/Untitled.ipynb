    "Jewellery",
    "Sports, Fitness & Outdoors",
    "Car & Motorbike",
    "Toys & Games",
    "Books",
    "Musical Instruments"
]

filtered_categories = {}

for name, link in unique_categories.items():

    if name in important_categories:
        filtered_categories[name] = link

filtered_categories


